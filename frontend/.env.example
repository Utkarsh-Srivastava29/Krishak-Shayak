# Backend API URL
# For local development: http://localhost:5000/api
# For production: https://your-backend-url.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Razorpay: no frontend keys needed. The backend returns the public key id
# with each payment order. NEVER put the key secret in a VITE_* variable:
# everything prefixed VITE_ is bundled into public JavaScript.

# Google Sheets Configuration
# To use your own sheet:
# 1. Create a Google Sheet with columns: id, name, department, launch_date, description, eligibility, benefits, official_link
# 2. Go to File > Share > Publish to web
# 3. Choose "Comma-separated values (.csv)" and publish
# 4. Copy the published URL and paste it below
VITE_SCHEMES_SHEET_URL=your_published_google_sheets_csv_url_here

# Weather and news API keys live on the backend (OPENWEATHER_API_KEY,
# NEWSDATA_API_KEY); the frontend calls /api/weather and /api/news.
